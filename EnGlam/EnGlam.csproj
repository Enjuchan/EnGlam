<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <AssemblyName>EnGlam</AssemblyName>
        <AssemblyVersion>0.2.2.0</AssemblyVersion>
        <FileVersion>0.2.2.0</FileVersion>
        <InformationalVersion>0.2.2.0</InformationalVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>
    <ItemGroup>
        <Content Include="EnGlam.json" CopyToOutputDirectory="Always" />
        <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\EnGlam.Core\EnGlam.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="ECommons" Version="3.2.1.26" />
      <PackageReference Include="LuminaSupplemental.Excel" Version="6.0.1" />
    </ItemGroup>
</Project>
